{
  "configVersion": "v3",
  "app": {
    "appId": 0,
    "appName": "HealthSync",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "dev",
    "description": "Sync health data to Google Sheets"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:user.hd.calories",
    "data:user.hd.sleep"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "active-2-round": {
      "module": {
        "page": {
          "pages": ["page/index"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "name": "active-2-round", "deviceSource": 8913152 },
        { "name": "active-2-round", "deviceSource": 8913153 },
        { "name": "active-2-round", "deviceSource": 8913155 },
        { "name": "active-2-round", "deviceSource": 8913159 },
        { "name": "active-2-round", "deviceSource": 10092800 },
        { "name": "active-2-round", "deviceSource": 10092801 },
        { "name": "active-2-round", "deviceSource": 10092803 },
        { "name": "active-2-round", "deviceSource": 10092807 }
      ],
      "designWidth": 466
    }
  },
  "i18n": {
    "en-US": {
      "appName": "HealthSync"
    }
  },
  "defaultLanguage": "en-US"
}
